# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings (choose one provider and set the matching key)
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your_openai_api_key_here

# Redis (Local fallback used if empty)
UPSTASH_REDIS_URL=redis://redis:6379/0

# Supabase (Local fallback used if empty)
SUPABASE_URL=postgresql://postgres:password@db:5432/agenticmesh
SUPABASE_SERVICE_ROLE_KEY=mock-key

# GitHub (Mocked locally for now)
GITHUB_TOKEN=mock_token
GITHUB_REPO=your-org/your-repo
